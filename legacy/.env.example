# ==================================================================
# Keyboard Designer 环境变量示例
# ------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env： cp .env.example .env
#   2. 将下方所有「请替换…」占位值改为真实值
#   3. .env 切勿提交到版本库，也不要随源码包一起交付
#
# 说明：
#   - 本文件中的变量由 docker-compose.yml 读取并注入到容器
#   - 标注 [必填] 的变量缺失会导致 API 无法启动
#   - 标注 [可选] 的变量留空时使用其默认值
#   - 生成随机密钥可用： openssl rand -base64 48
# ==================================================================

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=keyboard                   # [必填] 数据库用户名
POSTGRES_PASSWORD=请替换为强密码          # [必填] 数据库密码
POSTGRES_DB=keyboard                      # [必填] 数据库名
# 容器内 DATABASE_URL 由 Compose 自动拼接，无需在此配置

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=请替换为强密码             # [必填] Redis 访问密码

# ── JWT / 鉴权 ────────────────────────────────────────────────────
JWT_SECRET=请替换为 openssl rand -base64 48 的输出           # [必填] JWT 签名密钥
JWT_EXPIRES_IN=7d                                            # [可选] Token 有效期，默认 7d
SETUP_TOKEN_SECRET=请替换为另一段 openssl rand -base64 48    # [必填] 设置密码流程签名密钥（需与 JWT_SECRET 不同）

# ── 腾讯云 SES（邮箱 OTP 验证码，缺失时 API 无法启动）─────────────
TENCENT_SECRET_ID=请替换为腾讯云 SecretId       # [必填]
TENCENT_SECRET_KEY=请替换为腾讯云 SecretKey      # [必填]
TENCENT_SES_REGION=ap-guangzhou                 # [必填] SES 地域
TENCENT_SES_FROM=no-reply@你的域名.com          # [必填] 发信地址（需在腾讯云 SES 验证）
TENCENT_SES_TEMPLATE_ID=请替换为邮件模板 ID      # [必填] OTP 邮件模板 ID

# ── 腾讯云 COS（对象存储，用户字体 / 图片上传）───────────────────
TENCENT_COS_REGION=ap-guangzhou                 # [可选] COS 地域，默认 ap-guangzhou
TENCENT_COS_BUCKET=请替换为存储桶名称            # [必填] COS 存储桶
TENCENT_COS_DOMAIN=请替换为 COS 访问域名         # [必填] COS 访问域名（同时用于转曲 SSRF 白名单）

# ── 支付宝（电脑网站支付）─────────────────────────────────────────
ALIPAY_APP_ID=请替换为支付宝应用 AppId           # [必填]
ALIPAY_APP_PRIVATE_KEY=请替换为应用私钥          # [必填] 应用私钥（单行，勿换行）
ALIPAY_OFFICIAL_PUBLIC_KEY=请替换为支付宝公钥    # [必填] 支付宝公钥
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do   # [可选] 网关地址，默认线上正式网关
ALIPAY_NOTIFY_URL=https://你的域名.com/api/payments/alipay/notify   # [必填] 异步通知回调地址
ALIPAY_RETURN_URL=https://你的域名.com/orders                        # [必填] 同步跳转地址

# ── 微信支付（Native 扫码）────────────────────────────────────────
WECHAT_APP_ID=请替换为微信 AppId                 # [必填]
WECHAT_MCH_ID=请替换为微信商户号                 # [必填]
WECHAT_MCH_PRIVATE_KEY=请替换为商户 API 私钥     # [必填] 商户 API 证书私钥（单行）
WECHAT_API_V3_KEY=请替换为 APIv3 密钥            # [必填]
WECHAT_NOTIFY_URL=https://你的域名.com/api/payments/wechat/notify   # [必填] 异步通知回调地址
WECHAT_MCH_SERIAL_NO=请替换为商户证书序列号       # [必填]
