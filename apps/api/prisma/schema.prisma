// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 角色枚举
enum Role {
  USER       // 普通用户
  ADMIN      // 管理员
}

// 用户模型
model User {
  id        String   @id @default(uuid()) // 使用 UUID 作为主键，比自增 Int 更安全（防爬虫遍历 ID）
  email     String   @unique             // 邮箱，唯一索引，作为登录账号
  password  String                       // 哈希加密后的密码（绝对不能存明文！）
  
  // 角色字段：默认为普通用户
  role      Role     @default(USER)

  // 审计字段（生产环境必备）
  createdAt DateTime @default(now())    // 创建时间，默认当前时间
  updatedAt DateTime @updatedAt          // 更新时间，每次修改记录时 Prisma 会自动更新此时间

  // 关联
  designs   Design[]

  // 索引优化：高频查询的字段建议加索引（例如按激活状态、创建时间筛选）
  @@index([role])
  @@index([createdAt])
}

// 键盘设计方案
model Design {
  id         String   @id @default(cuid())
  name       String
  previewUrl String?
  data       Json
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}