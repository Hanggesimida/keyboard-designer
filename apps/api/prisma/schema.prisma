// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 角色枚举
enum Role {
  USER  // 普通用户
  ADMIN // 管理员
}

// 账号类型枚举：与 Role（后台权限）正交的业务角色维度
enum AccountType {
  NORMAL          // 普通用户（默认，下单需在线支付）
  ENTERPRISE_MAIN // 企业主账号：可创建/管理子账号，可审核并批量下单（月结免支付）
  ENTERPRISE_SUB  // 企业子账号（设计师）：仅能设计并提交，无法下单
}

// 设计方案状态枚举
enum DesignStatus {
  DRAFT     // 草稿
  SUBMITTED // 已提交，等待企业主账号审核/下单
  ORDERED   // 已下单（可重复下单）
}

// 订单状态枚举
enum OrderStatus {
  PENDING    // 待支付
  PAID       // 已支付（等待管理员接单）
  APPROVED   // 已接单（管理员确认）
  PROCESSING // 生产中
  SHIPPING   // 运输中
  COMPLETED  // 已完成
  CANCELLED  // 已取消
  REFUNDING  // 退款中
  REFUNDED   // 已退款
}

// 支付方式枚举
enum PaymentMethod {
  ALIPAY  // 支付宝
  WECHAT  // 微信支付
  MONTHLY // 月结（企业主账号下单免支付）
}

// 支付状态枚举
enum PaymentStatus {
  UNPAID   // 未支付
  PAID     // 已支付
  FAILED   // 支付失败
  REFUNDED // 已退款
}

// 退款状态枚举
enum RefundStatus {
  PENDING // 退款处理中
  SUCCESS // 退款成功
  FAILED  // 退款失败
}

// 通知类型枚举
enum NotificationType {
  ORDER_PAID           // 客户付款成功 → 需要接单操作
  ORDER_CANCELLED      // 客户主动取消订单
  ORDER_REFUND_REQUEST // 客户申请退款
}

// 用户模型
model User {
  id        String   @id @default(uuid()) // 使用 UUID 作为主键，比自增 Int 更安全（防爬虫遍历 ID）
  email     String   @unique             // 邮箱，唯一索引，作为登录账号
  password  String?                      // 哈希加密后的密码；OTP 注册时初始为 null，set-password 后填入
  name      String?                      // 显示名称；企业子账号创建时由主账号填写，其余场景可选
  
  // 角色字段：默认为普通用户
  role      Role     @default(USER)

  // 账号类型：企业主/子账号体系，与 role 正交
  accountType AccountType @default(NORMAL)
  isActive    Boolean     @default(true) // 企业主账号可禁用子账号登录；对普通用户/主账号无实际限制

  // 密码管理：子账号首登或主账号重置后须改密
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // 审计字段（生产环境必备）
  createdAt DateTime @default(now())    // 创建时间，默认当前时间
  updatedAt DateTime @updatedAt          // 更新时间，每次修改记录时 Prisma 会自动更新此时间

  // 企业主/子账号自关联：子账号的 parentId 指向所属主账号
  parentId    String?
  parent      User?  @relation("EnterpriseTeam", fields: [parentId], references: [id], onDelete: SetNull)
  subAccounts User[] @relation("EnterpriseTeam")

  // 关联
  designs   Design[]
  addresses Address[]
  orders    Order[]
  fonts     UserFont[]

  // 索引优化：高频查询的字段建议加索引（例如按激活状态、创建时间筛选）
  @@index([role])
  @@index([createdAt])
  @@index([accountType])
  @@index([parentId])
}

/// 全局唯一的字体二进制（内容寻址，SHA-256 去重）
model FontBlob {
  id          String   @id @default(cuid())
  contentHash String   @unique // sha256 hex
  cosKey      String // fonts/blobs/{hash}.{ext}
  url         String // 稳定公网 URL
  format      String // ttf | otf
  fileSize    Int
  familyName  String?
  createdAt   DateTime @default(now())

  userFonts UserFont[]
}

/// 用户字体库条目（指向共享 FontBlob）
model UserFont {
  id          String    @id @default(cuid())
  userId      String
  blobId      String
  displayName String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blob FontBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@unique([userId, blobId])
  @@index([userId, deletedAt])
}

// 键盘设计方案
model Design {
  id         String   @id @default(cuid())
  name       String
  previewUrl String?
  data       Json
  userId     String

  // 提交状态：企业子账号设计师用于向主账号提交审核；普通用户默认保持 DRAFT
  status      DesignStatus @default(DRAFT)
  submittedAt DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

// 收货地址
model Address {
  id       String @id @default(cuid())
  userId   String
  name     String // 收件人姓名
  phone    String // 手机号
  province String // 省
  city     String // 市
  district String // 区/县
  detail   String // 详细地址

  isDefault Boolean @default(false) // 是否为默认地址

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// 订单
model Order {
  id       String @id @default(cuid())
  orderNo  String @unique // 可读订单号，格式 JW-YYYYMMDD-XXXXX

  userId    String
  designId  String
  addressId String

  designSnapshot  Json // 下单时固化的设计数据快照
  addressSnapshot Json // 下单时固化的地址信息快照

  status      OrderStatus @default(PENDING)
  quantity    Int         @default(1) // 购买套数
  totalAmount Decimal     @db.Decimal(10, 2)
  note        String?     // 买家备注

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  design  Design  @relation(fields: [designId], references: [id], onDelete: Restrict)
  address Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  payment Payment?
  refunds Refund[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// 支付记录
model Payment {
  id      String @id @default(cuid())
  orderId String @unique // 与 Order 1:1

  method PaymentMethod
  status PaymentStatus @default(UNPAID)
  amount Decimal       @db.Decimal(10, 2)

  paidAt DateTime?

  // 预留给第三方支付平台的数据
  thirdPartyId   String? // 第三方交易流水号
  thirdPartyData Json?   // 第三方回调原始数据

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([status])
}

// 退款记录（支付宝退款幂等与审计）
model Refund {
  id             String       @id @default(cuid())
  orderId        String
  paymentId      String
  amount         Decimal      @db.Decimal(10, 2)
  outRequestNo   String       @unique // 支付宝退款幂等号
  status         RefundStatus @default(PENDING)
  reason         String?
  operatorId     String?      // 操作管理员 userId
  thirdPartyData Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([paymentId])
}

// 管理员通知
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  data      Json?            // { orderId, orderNo, userId, amount, ... }
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead])
  @@index([createdAt])
}